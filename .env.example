# Django Multi-Tenant Application Environment Variables
# Copy this file to .env and customize for your deployment

# =============================================================================
# BASIC DJANGO SETTINGS
# =============================================================================
# Secret key for Django (generate a new one for production)
SECRET_KEY=django-insecure-0peo@#x9jur3!h$ryje!$879xww8y1y66jx!%*#ymhg&jkozs2

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts for the application
ALLOWED_HOSTS=localhost,0.0.0.0,127.0.0.1,testserver

# Environment (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database engine (sqlite3 for development, postgresql for production)
DB_ENGINE=django.db.backends.sqlite3

# Database name (path for SQLite, name for PostgreSQL)
DB_NAME=django_project/db.sqlite3

# Database credentials (for PostgreSQL)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Database connection settings
DB_ISOLATION_LEVEL=READ COMMITTED
DB_CONNECT_TIMEOUT=60
DB_APPLICATION_NAME=lawyer_multitenant

# Database connection pooling
DATABASE_CONNECTION_MAX_AGE=60
DATABASE_CONNECTION_POOL_SIZE=10
DATABASE_CONNECTION_POOL_MAX_OVERFLOW=20

# Database query optimization
DATABASE_QUERY_TIMEOUT=30
DATABASE_QUERY_CACHE_ENABLED=True
DATABASE_QUERY_CACHE_TIMEOUT=300

# =============================================================================
# MULTI-TENANT SETTINGS
# =============================================================================
# Tenant model
TENANT_MODEL=tenants.Tenant

# Tenant detection method (path, subdomain, header)
TENANT_DETECTION_METHOD=path

# Tenant URL configuration
TENANT_URL_PREFIX=app
TENANT_HEADER_NAME=X-Tenant-ID
TENANT_SUBDOMAIN_DOMAIN=lawfirm.com

# Tenant isolation settings
TENANT_ISOLATION_ENABLED=True
TENANT_STRICT_ISOLATION=True
TENANT_SHARED_MODELS=

# Default tenant settings
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Law Firm
DEFAULT_TENANT_PLAN=basic

# Tenant cache configuration
TENANT_CACHE_TIMEOUT=300
TENANT_CACHE_PREFIX=tenant
TENANT_CACHE_SETTINGS_TIMEOUT=300
TENANT_SETTINGS_CACHE_KEY=tenant_settings_{tenant_id}
TENANT_BRANDING_CACHE_KEY=tenant_branding_{tenant_id}

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache backend (locmem, filebased, redis)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Cache location (for file-based cache)
CACHE_LOCATION=/tmp/django_cache

# Cache settings
CACHE_TIMEOUT=300
CACHE_KEY_PREFIX=lawyer
CACHE_OPTIONS=

# Redis configuration
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=
REDIS_DB=1
REDIS_MAX_CONNECTIONS=50
USE_REDIS_CACHE=False

# Tenant cache settings
TENANT_CACHE_KEY_PREFIX=tenant_{tenant_id}
TENANT_CACHE_ISOLATION=True
TENANT_CACHE_SEPARATOR=_
TENANT_CACHE_VERSION=1

# =============================================================================
# STATIC AND MEDIA FILES
# =============================================================================
# Static file settings
STATIC_URL=/static/
STATIC_ROOT=django_project/staticfiles
TENANT_STATIC_URL=/static/tenants/
TENANT_STATIC_ROOT=django_project/staticfiles/tenants

# Media file settings
MEDIA_URL=/media/
MEDIA_ROOT=django_project/media
TENANT_MEDIA_URL=/media/tenants/
TENANT_MEDIA_ROOT=django_project/media/tenants

# CDN configuration
CDN_ENABLED=False
CDN_BASE_URL=
CDN_TENANT_PREFIX=tenants

# Tenant file upload settings
TENANT_UPLOAD_MAX_SIZE=10485760
TENANT_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Email backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Email settings
DEFAULT_FROM_EMAIL=root@localhost

# Tenant email settings
TENANT_EMAIL_FROM_NAME={company_name}
TENANT_EMAIL_FROM_ADDRESS=noreply@{tenant_slug}.lawfirm.com
TENANT_EMAIL_REPLY_TO=support@{tenant_slug}.lawfirm.com

# Tenant email backend
TENANT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
TENANT_EMAIL_QUEUE_ENABLED=True
TENANT_EMAIL_BULK_SENDING=True

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CSRF settings
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Tenant security settings
TENANT_SECURITY_ENABLED=True
TENANT_CROSS_TENANT_ACCESS_PREVENTION=True
TENANT_DATA_ISOLATION_LEVEL=strict

# Session security
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=1209600
TENANT_SESSION_KEY=tenant_id
TENANT_SESSION_ISOLATION=True

# Additional security
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_REDIRECT_EXEMPT=

# Tenant security headers
TENANT_SECURITY_HEADERS=True
TENANT_CSP_ENABLED=False
TENANT_CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self';

# Rate limiting
TENANT_RATE_LIMIT_ENABLED=True
TENANT_RATE_LIMIT_REQUESTS=1000
TENANT_RATE_LIMIT_WINDOW=3600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging settings
DJANGO_LOG_LEVEL=INFO
TENANT_LOG_LEVEL=INFO
AUDIT_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARNING
ROOT_LOG_LEVEL=WARNING

# Log files
LOG_FILE=django_project/logs/django.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5

# Tenant log settings
TENANT_LOG_DIR=django_project/logs/tenants
TENANT_LOG_ENABLED=True
TENANT_LOG_FORMAT=tenant_{tenant_id}.log
TENANT_LOG_MAX_SIZE=5242880
TENANT_LOG_BACKUP_COUNT=3

# Audit logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_SENSITIVE_DATA=False

# Error reporting
ERROR_REPORTING_ENABLED=True
TENANT_ERROR_REPORTING=True

# =============================================================================
# THIRD-PARTY APP SETTINGS
# =============================================================================
# Django-allauth settings
ACCOUNT_ADAPTER=tenants.adapters.TenantAccountAdapter
SOCIALACCOUNT_ADAPTER=tenants.adapters.TenantSocialAccountAdapter
ACCOUNT_SIGNUP_FORM_CLASS=tenants.forms.TenantSignupForm

# Django admin settings
ADMIN_ENABLED=True
TENANT_ADMIN_ENABLED=True
TENANT_ADMIN_SITE_HEADER={company_name} Administration
TENANT_ADMIN_SITE_TITLE={company_name} Admin
TENANT_ADMIN_INDEX_TITLE={company_name} Administration

# Celery settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=True

# Celery queues
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_QUEUES=default,tenants,billing,audit,backup

# =============================================================================
# ENVIRONMENT-SPECIFIC SETTINGS
# =============================================================================
# Debug settings per tenant
TENANT_DEBUG_OVERRIDE=False
TENANT_DEBUG_ALLOWED_SLUGS=

# API configuration
API_ENABLED=True
API_VERSION=v1
API_URL_PREFIX=/api/
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=3600

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Database connection pooling
DATABASE_SELECT_RELATED=True
DATABASE_PREFETCH_RELATED=True
DATABASE_OPTIMIZE_QUERIES=True

# Caching strategies
CACHE_MIDDLEWARE_ALIAS=default
CACHE_MIDDLEWARE_SECONDS=300
CACHE_MIDDLEWARE_KEY_PREFIX=
CACHE_MIDDLEWARE_ANONYMOUS_ONLY=True

# Performance monitoring
PERFORMANCE_MONITORING_ENABLED=True
PERFORMANCE_LOG_SLOW_QUERIES=True
PERFORMANCE_SLOW_QUERY_THRESHOLD=1000

# Background tasks
BACKGROUND_TASK_ENABLED=True
BACKGROUND_TASK_RUN_EVERY_MINS=5
BACKGROUND_TASK_MAX_ATTEMPTS=3

# =============================================================================
# VALIDATION SETTINGS
# =============================================================================
# Settings validation
VALIDATE_SETTINGS_ON_STARTUP=True